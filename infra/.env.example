# Postgres
POSTGRES_USER=ridetracking
POSTGRES_PASSWORD=ridetracking
POSTGRES_DB=ridetracking
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Host port bindings for the app services (containers talk to each other by
# service name on the Docker network regardless of these values)
CORE_PORT=3000
ML_SERVICE_PORT=8000

# Stamped into both services' /health "build" field
BUILD_VERSION=local
