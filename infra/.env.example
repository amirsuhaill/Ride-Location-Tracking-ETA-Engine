# Postgres
POSTGRES_USER=ridetracking
POSTGRES_PASSWORD=ridetracking
POSTGRES_DB=ridetracking
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# OSRM (Phase 15, see docs/osrm-routing.md). Default host port 5001, not 5000 — on macOS,
# AirPlay Receiver/ControlCenter already binds 5000 by default.
OSRM_PORT=5001

# Host port bindings for the app services (containers talk to each other by
# service name on the Docker network regardless of these values)
CORE_PORT=3000
ML_SERVICE_PORT=8000

# Whether core's heuristic ETA path calls the real OSRM service — off by default (see
# core/.env.example's ETA_OSRM_ENABLED doc comment).
ETA_OSRM_ENABLED=false

# Browser origins allowed to call core cross-origin (comma-separated) — see
# core/.env.example's CORS_ORIGINS doc comment.
CORS_ORIGINS=http://localhost:5173

# Frontend Phase 10 (see docs/frontend-deploy.md): core now serves the built frontend itself and
# generates /runtime-config.js from these. Leave both empty (the default) for a normal `make up` —
# the served config then derives from the real request's own Host header, correct with zero
# config. Set both only to point the exact same built frontend at a *different* running core
# instance, e.g. PUBLIC_CORE_API_URL=http://api.example.com,
# PUBLIC_CORE_WS_URL=ws://api.example.com — no image rebuild needed either way.
PUBLIC_CORE_API_URL=
PUBLIC_CORE_WS_URL=

# Stamped into both services' /health "build" field
BUILD_VERSION=local
