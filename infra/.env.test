# Config for the disposable test database/cache (infra/docker-compose.test.yml).
# Intentionally committed (not gitignored like infra/.env): neither ever holds real or secret
# data — both are created fresh and torn down by `npm test` every run.
TEST_POSTGRES_USER=ridetracking_test
TEST_POSTGRES_PASSWORD=ridetracking_test
TEST_POSTGRES_DB=ridetracking_test
TEST_POSTGRES_PORT=5433

TEST_REDIS_PORT=6380
