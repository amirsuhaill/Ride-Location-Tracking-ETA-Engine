# HTTP server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Postgres connection string (see /infra for docker-compose defaults)
DATABASE_URL=postgresql://ridetracking:ridetracking@localhost:5432/ridetracking

# Redis connection string
REDIS_URL=redis://localhost:6379

# Base URL of the core service, used for internal HTTP calls
CORE_SERVICE_URL=http://localhost:3000

# Real road-network routing via OSRM (Phase 15, see docs/osrm-routing.md) — used only by
# scripts/train_model.py's retraining pipeline.
OSRM_URL=http://localhost:5001
OSRM_TIMEOUT_SECONDS=2.0

# Reported by /health
APP_VERSION=0.1.0
BUILD_VERSION=local
