# Base URL of core's REST API. Read via Vite's import.meta.env (see src/config.ts) — must be
# prefixed VITE_ or Vite won't expose it to client code, and is baked into the build at
# `vite build` time, not read at container start.
VITE_CORE_API_URL=http://localhost:3000

# Base URL of core's WebSocket endpoints (/ws/driver, /ws/subscribe).
VITE_CORE_WS_URL=ws://localhost:3000
