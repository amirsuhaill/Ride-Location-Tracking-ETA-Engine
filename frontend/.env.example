# Dev-mode-only fallback for core's REST API base URL (see src/config.ts). Only used when
# `npm run dev`/`vite preview` serves this app directly — must be prefixed VITE_ or Vite won't
# expose it to client code, and is baked in at `vite build` time. When core itself serves this
# app's build output (the real `make up` deployment path, docs/frontend-deploy.md), core's own
# /runtime-config.js sets window.__RUNTIME_CONFIG__ before this app boots and these values are
# never read at all.
VITE_CORE_API_URL=http://localhost:3000

# Dev-mode-only fallback for core's WebSocket endpoints (/ws/driver, /ws/subscribe) — same caveat
# as VITE_CORE_API_URL above.
VITE_CORE_WS_URL=ws://localhost:3000
