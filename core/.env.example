# HTTP server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Process timezone — set explicitly so the ETA rush-hour table (docs/eta.md) evaluates against
# this project's actual seeded-city (San Francisco) local time, not the container's default UTC.
TZ=America/Los_Angeles

# Postgres connection string (see /infra for docker-compose defaults)
DATABASE_URL=postgres://ridetracking:ridetracking@localhost:5432/ridetracking

# Redis connection string
REDIS_URL=redis://localhost:6379

# A driver's live Redis geo/status entry older than this is treated as stale and excluded from
# nearby search (see docs/redis-geo.md)
DRIVER_STALE_MS=90000

# How often the background job scans for and reconciles stale driver entries
RECONCILE_INTERVAL_MS=30000

# Max processed driver location updates per second over WebSocket; extras within the window are
# coalesced (last-value-wins), not dropped (see docs/websockets.md)
WS_DRIVER_THROTTLE_MS=1000

# Ping/pong heartbeat interval for WebSocket connections (dead-connection detection)
WS_HEARTBEAT_INTERVAL_MS=30000

# A driver location update's client-supplied timestamp must be within this many ms of server time
# (rejects clock-skewed/replayed updates)
WS_TIMESTAMP_TOLERANCE_MS=300000

# Fleet-wide window over which driver location updates are batched into a single Redis+Postgres
# flush and broadcast pass, instead of one round-trip per update (see
# docs/ws-batching-and-compression.md). Hard-capped at 1000ms regardless of this value.
WS_BATCH_WINDOW_MS=300

# How often the cumulative delta-compression bandwidth savings summary is logged
WS_BANDWIDTH_LOG_INTERVAL_MS=30000

# Trip-matching (see docs/matching.md): search radius/candidate count, driver-offer timeout, and
# scoring weights (distance/idle-time/rating). Weights are a tunable heuristic, not a claim of
# optimality — see docs/matching.md for the rationale.
MATCH_SEARCH_RADIUS_METERS=5000
MATCH_MAX_CANDIDATES=5
MATCH_OFFER_TIMEOUT_MS=10000
MATCH_DISTANCE_WEIGHT=0.6
MATCH_IDLE_TIME_WEIGHT=0.25
MATCH_RATING_WEIGHT=0.15
MATCH_MAX_IDLE_TIME_MS=600000

# Baseline heuristic ETA (see docs/eta.md): average speed, throttled-recompute thresholds (N
# seconds OR M meters moved, whichever hits first), and how old a driver's location can be
# before it's too stale to trust for an ETA.
ETA_AVG_SPEED_MPS=8
ETA_RECOMPUTE_INTERVAL_MS=15000
ETA_RECOMPUTE_DISTANCE_METERS=200
ETA_STALE_LOCATION_MS=60000

# ML ETA integration (Phase 10, see docs/eta-integration.md). ETA_MODE is one of "heuristic"
# (default — never calls ml-service), "ml" (ml-service only, no fallback — ML failures are
# surfaced as a distinct "ml_unavailable" status, not masked), or "ml_with_fallback" (tries
# ml-service first, falls back to the heuristic on any failure: unreachable, timeout, or a
# malformed/error response).
ETA_MODE=heuristic
# Max time to wait for ml-service's /predict-eta before treating it as a failure.
ETA_ML_TIMEOUT_MS=200
# Minimum time between ML recomputes for a given trip — separate from (and much shorter than)
# ETA_RECOMPUTE_INTERVAL_MS, since an ML call is a network hop worth protecting ml-service from
# being hammered by rapid location updates, unlike the free local heuristic calculation. Uses the
# exact same throttle mechanism as ETA_RECOMPUTE_INTERVAL_MS, just a different threshold value.
ETA_ML_CACHE_TTL_MS=5000

# Real road-network routing via OSRM (Phase 15, see docs/osrm-routing.md). Off by default — a
# fresh checkout without a built OSRM dataset (infra/scripts/prepare-osrm-data.sh) degrades to
# plain haversine, unchanged from pre-Phase-15 behavior.
OSRM_URL=http://localhost:5001
ETA_OSRM_ENABLED=false
# Max time to wait for OSRM's /route before falling back to the haversine heuristic.
ETA_OSRM_TIMEOUT_MS=300

# Surge pricing (Phase 13, see docs/surge-pricing.md). Zones are geohash cells sized from
# SURGE_ZONE_RADIUS_METERS (Phase 12's precisionForRadius). Surge is recomputed on a fixed
# interval (never per-request), smoothed by at most SURGE_MAX_CHANGE_PER_INTERVAL per tick, and
# bounded to [SURGE_MIN_MULTIPLIER, SURGE_MAX_MULTIPLIER] — a zone needs at least
# SURGE_MIN_SAMPLE_REQUESTS open requests before surge moves off the floor at all.
SURGE_ZONE_RADIUS_METERS=2000
SURGE_UPDATE_INTERVAL_MS=15000
SURGE_MIN_MULTIPLIER=1.0
SURGE_MAX_MULTIPLIER=3.0
SURGE_MIN_SAMPLE_REQUESTS=3
SURGE_MAX_CHANGE_PER_INTERVAL=0.3

# Fare estimate (Phase 13, see docs/surge-pricing.md) — base + per-km + per-minute, in cents,
# multiplied by the pickup zone's surge multiplier. Returned on POST /trips, not persisted.
FARE_BASE_CENTS=250
FARE_PER_KM_CENTS=150
FARE_PER_MINUTE_CENTS=25

# Historical trip data simulator (see docs/historical-data-simulator.md), run via
# `npm run simulate:trips` — not read by the running server, only by that one script. All
# optional; together they form the full reproducibility contract (same values in, same dataset
# out, regardless of when the script actually runs).
# SIM_SEED=42
# SIM_TRIP_COUNT=5000
# SIM_DAYS=30
# SIM_END_DATE=2026-01-01

# Base URL of the ml-service, used for internal HTTP calls
ML_SERVICE_URL=http://localhost:8000

# Browser origins allowed to call this API cross-origin (comma-separated) — see
# src/server.ts's @fastify/cors registration. Default is Vite's own dev server port, so
# `npm run dev` in /frontend works against a locally running core with no extra config.
CORS_ORIGINS=http://localhost:5173

# Reported by /health
APP_VERSION=0.1.0
BUILD_VERSION=local
