{
  "name": "core",
  "version": "0.1.0",
  "private": true,
  "description": "API, WebSocket server, and matching logic for the ride-tracking platform.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:redo": "node-pg-migrate redo",
    "migrate:create": "node-pg-migrate create --",
    "seed": "tsx scripts/seed.ts",
    "db:explain": "tsx scripts/explain-geo-query.ts",
    "ws:throttle-check": "tsx scripts/ws-throttle-client.ts",
    "load-test:fleet": "tsx scripts/load-test-driver-fleet.ts",
    "test": "bash scripts/test.sh"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "ioredis": "^6.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.20.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "vitest": "^4.1.10"
  }
}
